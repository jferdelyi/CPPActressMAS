{
	"version": 6,
	"cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/$env{CAM_BUILD_PREFIX}${presetName}",
			"cacheVariables": {
				"BUILD_EXAMPLES": "ON",
				"CAM_TRANSPORT_MQTT": "ON",
				"CAM_TRANSPORT_ZENOH": "ON",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "debug",
			"displayName": "Debug",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "release",
			"displayName": "Release (project flags: -march=native, -O3, -flto)",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "core",
			"displayName": "Debug, core only (no network transport, no libmosquitto, no OpenSSL, no Zenoh)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CAM_TRANSPORT_MQTT": "OFF",
				"CAM_TRANSPORT_ZENOH": "OFF"
			}
		},
		{
			"name": "asan",
			"displayName": "Debug + AddressSanitizer + UndefinedBehaviorSanitizer",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CAM_SANITIZER": "asan",
				"CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
				"CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
				"CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
				"CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
			}
		},
		{
			"name": "tsan",
			"displayName": "Debug + ThreadSanitizer",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CAM_SANITIZER": "tsan",
				"CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
				"CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
				"CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
				"CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
			}
		},
		{
			"name": "coverage",
			"displayName": "Debug + clang source-based coverage (llvm-profdata, llvm-cov)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
				"CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
				"CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate"
			}
		},
		{
			"name": "bench",
			"displayName": "Benchmarks (-O3 -DNDEBUG, no -march=native, no -flto, core only)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "None",
				"CMAKE_CXX_FLAGS": "-O3 -DNDEBUG",
				"BUILD_BENCH": "ON",
				"CAM_TRANSPORT_MQTT": "OFF",
				"CAM_TRANSPORT_ZENOH": "OFF"
			}
		},
		{
			"name": "msvc",
			"displayName": "Windows, MSVC, static library and tests, core only (the shared library exports no symbol yet)",
			"inherits": "base",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"cacheVariables": {
				"BUILD_SHARED": "OFF",
				"BUILD_EXAMPLES": "OFF",
				"CAM_TRANSPORT_MQTT": "OFF",
				"CAM_TRANSPORT_ZENOH": "OFF"
			}
		}
	],
	"buildPresets": [
		{ "name": "debug", "configurePreset": "debug" },
		{ "name": "release", "configurePreset": "release" },
		{ "name": "core", "configurePreset": "core" },
		{ "name": "asan", "configurePreset": "asan" },
		{ "name": "tsan", "configurePreset": "tsan" },
		{ "name": "coverage", "configurePreset": "coverage" },
		{ "name": "bench", "configurePreset": "bench" },
		{ "name": "msvc", "configurePreset": "msvc", "configuration": "Debug" }
	],
	"testPresets": [
		{
			"name": "base",
			"hidden": true,
			"output": { "outputOnFailure": true },
			"execution": { "noTestsAction": "error" }
		},
		{
			"name": "parallel",
			"hidden": true,
			"inherits": "base",
			"description": "Eight tests at once (safe: shared files are locked by RESOURCE_LOCK); the sanitizer presets stay serial",
			"execution": { "noTestsAction": "error", "jobs": 8 }
		},
		{ "name": "type-unit", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^unit$" } } },
		{ "name": "type-integration", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^integration$" } } },
		{ "name": "type-network", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^network$" } } },
		{ "name": "type-characterization", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^characterization$" } } },
		{ "name": "type-iso", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^iso$" } } },
		{ "name": "type-examples", "hidden": true, "inherits": "base", "filter": { "include": { "label": "^examples$" } } },
		{ "name": "debug", "configurePreset": "debug", "inherits": "parallel" },
		{ "name": "release", "configurePreset": "release", "inherits": "parallel" },
		{ "name": "core", "configurePreset": "core", "inherits": "parallel" },
		{ "name": "asan", "configurePreset": "asan", "inherits": "base" },
		{ "name": "tsan", "configurePreset": "tsan", "inherits": "base" },
		{
			"name": "coverage",
			"configurePreset": "coverage",
			"inherits": "parallel",
			"description": "One profile per process, merged and reported by tests/tools/coverage.sh",
			"environment": { "LLVM_PROFILE_FILE": "${sourceDir}/build/$env{CAM_BUILD_PREFIX}coverage/profiles/cam-%p.profraw" }
		},
		{ "name": "bench", "configurePreset": "bench", "inherits": "parallel" },
		{ "name": "msvc", "configurePreset": "msvc", "inherits": "parallel", "configuration": "Debug" },
		{ "name": "debug-unit", "configurePreset": "debug", "inherits": "type-unit" },
		{ "name": "debug-integration", "configurePreset": "debug", "inherits": "type-integration" },
		{ "name": "debug-network", "configurePreset": "debug", "inherits": "type-network" },
		{ "name": "debug-characterization", "configurePreset": "debug", "inherits": "type-characterization" },
		{ "name": "debug-iso", "configurePreset": "debug", "inherits": "type-iso" },
		{ "name": "debug-examples", "configurePreset": "debug", "inherits": "type-examples" },
		{ "name": "release-unit", "configurePreset": "release", "inherits": "type-unit" },
		{ "name": "release-integration", "configurePreset": "release", "inherits": "type-integration" },
		{ "name": "release-network", "configurePreset": "release", "inherits": "type-network" },
		{ "name": "release-characterization", "configurePreset": "release", "inherits": "type-characterization" },
		{ "name": "release-iso", "configurePreset": "release", "inherits": "type-iso" },
		{ "name": "release-examples", "configurePreset": "release", "inherits": "type-examples" },
		{ "name": "core-unit", "configurePreset": "core", "inherits": "type-unit" },
		{ "name": "core-integration", "configurePreset": "core", "inherits": "type-integration" },
		{ "name": "core-network", "configurePreset": "core", "inherits": "type-network" },
		{ "name": "core-characterization", "configurePreset": "core", "inherits": "type-characterization" },
		{ "name": "core-iso", "configurePreset": "core", "inherits": "type-iso" },
		{ "name": "core-examples", "configurePreset": "core", "inherits": "type-examples" },
		{ "name": "asan-unit", "configurePreset": "asan", "inherits": "type-unit" },
		{ "name": "asan-integration", "configurePreset": "asan", "inherits": "type-integration" },
		{ "name": "asan-network", "configurePreset": "asan", "inherits": "type-network" },
		{ "name": "asan-characterization", "configurePreset": "asan", "inherits": "type-characterization" },
		{ "name": "asan-iso", "configurePreset": "asan", "inherits": "type-iso" },
		{ "name": "asan-examples", "configurePreset": "asan", "inherits": "type-examples" },
		{ "name": "tsan-unit", "configurePreset": "tsan", "inherits": "type-unit" },
		{ "name": "tsan-integration", "configurePreset": "tsan", "inherits": "type-integration" },
		{ "name": "tsan-network", "configurePreset": "tsan", "inherits": "type-network" },
		{ "name": "tsan-characterization", "configurePreset": "tsan", "inherits": "type-characterization" },
		{ "name": "tsan-iso", "configurePreset": "tsan", "inherits": "type-iso" },
		{ "name": "tsan-examples", "configurePreset": "tsan", "inherits": "type-examples" },
		{ "name": "msvc-unit", "configurePreset": "msvc", "inherits": "type-unit", "configuration": "Debug" },
		{ "name": "msvc-integration", "configurePreset": "msvc", "inherits": "type-integration", "configuration": "Debug" },
		{ "name": "msvc-network", "configurePreset": "msvc", "inherits": "type-network", "configuration": "Debug" },
		{ "name": "msvc-characterization", "configurePreset": "msvc", "inherits": "type-characterization", "configuration": "Debug" },
		{ "name": "msvc-iso", "configurePreset": "msvc", "inherits": "type-iso", "configuration": "Debug" }
	],
	"workflowPresets": [
		{ "name": "debug", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug" } ] },
		{ "name": "release", "steps": [ { "type": "configure", "name": "release" }, { "type": "build", "name": "release" }, { "type": "test", "name": "release" } ] },
		{ "name": "core", "steps": [ { "type": "configure", "name": "core" }, { "type": "build", "name": "core" }, { "type": "test", "name": "core" } ] },
		{ "name": "asan", "steps": [ { "type": "configure", "name": "asan" }, { "type": "build", "name": "asan" }, { "type": "test", "name": "asan" } ] },
		{ "name": "tsan", "steps": [ { "type": "configure", "name": "tsan" }, { "type": "build", "name": "tsan" }, { "type": "test", "name": "tsan" } ] },
		{ "name": "coverage", "steps": [ { "type": "configure", "name": "coverage" }, { "type": "build", "name": "coverage" }, { "type": "test", "name": "coverage" } ] },
		{ "name": "bench", "steps": [ { "type": "configure", "name": "bench" }, { "type": "build", "name": "bench" }, { "type": "test", "name": "bench" } ] },
		{ "name": "msvc", "steps": [ { "type": "configure", "name": "msvc" }, { "type": "build", "name": "msvc" }, { "type": "test", "name": "msvc" } ] },
		{ "name": "unit", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug-unit" } ] },
		{ "name": "integration", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug-integration" } ] },
		{ "name": "network", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug-network" } ] },
		{ "name": "characterization", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug-characterization" } ] },
		{ "name": "iso", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug-iso" } ] },
		{ "name": "examples", "steps": [ { "type": "configure", "name": "debug" }, { "type": "build", "name": "debug" }, { "type": "test", "name": "debug-examples" } ] }
	]
}
