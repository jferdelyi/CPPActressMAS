<Project Sdk="Microsoft.NET.Sdk">
  <!-- E20 RemoteMessages without WinForms: same agents, same setup per container, console output. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../ActressMas.Wire/ActressMas.Wire.csproj" />
  </ItemGroup>
</Project>
