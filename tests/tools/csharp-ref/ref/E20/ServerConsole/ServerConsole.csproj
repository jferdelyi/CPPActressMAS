<Project Sdk="Microsoft.NET.Sdk">
  <!-- E20 MyServerConsole without the console UI: the original Server(port, ping), every log line printed, stops after a delay. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../ActressMas.Wire/ActressMas.Wire.csproj" />
  </ItemGroup>
</Project>
