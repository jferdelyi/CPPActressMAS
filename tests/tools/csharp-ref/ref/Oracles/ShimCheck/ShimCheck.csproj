<Project Sdk="Microsoft.NET.Sdk">
  <!-- RngVectors compiled through the seed shim: its output must be identical to ref/expected/rng-vectors.txt,
       which proves that SeededRandom draws exactly as the seeded System.Random -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ShimCheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../RngVectors/Program.cs" />
    <Compile Include="../Shim/*.cs" />
  </ItemGroup>
</Project>
