<Project Sdk="Microsoft.NET.Sdk">
  <!-- Oracle of the C# example E13 Game of Life (D86), see ../Oracle.props: the WinForms form is replaced by
       Stubs/GridForm.cs, which prints the grid it would draw; oracle.sed bounds noTurns; patterns.txt, shipped only
       next to the original binary, is copied next to this one (read from the working directory). -->
  <PropertyGroup>
    <OracleSources>$(AmasEx)E13 Game of Life/</OracleSources>
    <OracleExcludes>$(OracleSources)GridForm.cs;$(OracleSources)GridForm.Designer.cs</OracleExcludes>
    <OracleData>$(OracleSources)bin/Release/patterns.txt</OracleData>
  </PropertyGroup>
  <Import Project="../Oracle.props" />
</Project>
